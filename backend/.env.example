# AI-Mentor Platform — Configuration
# Copy this file to .env and fill in your values.

# Platform database (read-write)
PLATFORM_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_mentor_platform

# Training database (read-only)
TRAINING_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_mentor_training

# Training query timeout in seconds
TRAINING_STATEMENT_TIMEOUT=30

# JWT
# Generate a strong secret key using: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# GigaChat (Sberbank LLM) — replaces Nvidia Nemotron
# Get your auth key from https://developers.sber.ru/studio/
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_API_BASE=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_MODEL=GigaChat
# Set to false if you don't have the NUZ Mintcifry CA cert installed
GIGACHAT_SSL_VERIFY=false